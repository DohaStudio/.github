{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dohastudio.org/common-ai/v1/provider-capability.schema.json",
  "title": "ProviderCapability v1",
  "allOf": [{"$ref": "common-envelope.schema.json"}],
  "type": "object",
  "required": ["provider_id", "capability_id", "capability_version", "input_schema_refs", "output_schema_refs", "supported_operations", "execution_mode", "streaming_supported", "cancellation_supported", "contract_compatibility_range", "model_version_ids", "constraints", "status"],
  "properties": {
    "schema_name": {"const": "provider_capability"},
    "provider_id": {"enum": ["dohalm", "dohaaudio", "dohavocal"]},
    "capability_id": {"$ref": "common-envelope.schema.json#/$defs/id"},
    "capability_version": {"$ref": "common-envelope.schema.json#/$defs/semver"},
    "input_schema_refs": {"type": "array", "items": {"$ref": "common-envelope.schema.json#/$defs/reference"}, "minItems": 1},
    "output_schema_refs": {"type": "array", "items": {"$ref": "common-envelope.schema.json#/$defs/reference"}, "minItems": 1},
    "supported_operations": {"type": "array", "items": {"enum": ["regenerate", "replace", "extend", "shorten", "rewrite", "mix", "analyze", "reference", "similarity_revision", "planning"]}, "minItems": 1, "uniqueItems": true},
    "execution_mode": {"enum": ["sync", "async", "streaming"]},
    "streaming_supported": {"type": "boolean"},
    "cancellation_supported": {"type": "boolean"},
    "contract_compatibility_range": {"type": "string", "pattern": "^>=1\\.0\\.0 <2\\.0\\.0$"},
    "model_version_ids": {"type": "array", "items": {"$ref": "common-envelope.schema.json#/$defs/id"}, "uniqueItems": true},
    "constraints": {"type": "object"},
    "status": {"enum": ["planned", "available", "degraded", "unavailable", "deprecated"]},
    "deprecated_at": {"type": "string", "format": "date-time"},
    "superseded_by": {"$ref": "common-envelope.schema.json#/$defs/id"}
  },
  "if": {"properties": {"status": {"const": "deprecated"}}},
  "then": {"anyOf": [{"required": ["deprecated_at"]}, {"required": ["superseded_by"]}]},
  "unevaluatedProperties": false
}
