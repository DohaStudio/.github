{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dohastudio.org/common-ai/v1/dataset-version.schema.json",
  "title": "DatasetVersion v1",
  "allOf": [{"$ref": "common-envelope.schema.json"}],
  "type": "object",
  "required": ["dataset_id", "dataset_version", "status", "usage_purpose", "task", "lineage", "created_from", "candidate_count", "split_manifest", "schema_manifest_id", "rights_summary", "dataset_eligibility_evidence_id", "approval_evidence_ids", "approved", "frozen", "training_allowed", "dataset_manifest_id", "content_fingerprint"],
  "properties": {
    "schema_name": {"const": "dataset_version"},
    "dataset_id": {"$ref": "common-envelope.schema.json#/$defs/id"},
    "dataset_version": {"$ref": "common-envelope.schema.json#/$defs/semver"},
    "status": {"enum": ["draft", "reviewing", "approved", "frozen", "retired"]},
    "usage_purpose": {"type": "string", "minLength": 1},
    "task": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}]},
    "lineage": {"type": "array", "items": {"$ref": "common-envelope.schema.json#/$defs/reference"}, "minItems": 1},
    "created_from": {"$ref": "common-envelope.schema.json#/$defs/checksum"},
    "candidate_count": {"type": "integer", "minimum": 1},
    "split_manifest": {
      "type": "object",
      "required": ["train", "validation", "test", "group_keys"],
      "properties": {
        "train": {"type": "array", "items": {"$ref": "common-envelope.schema.json#/$defs/id"}, "minItems": 1, "uniqueItems": true},
        "validation": {"type": "array", "items": {"$ref": "common-envelope.schema.json#/$defs/id"}, "minItems": 1, "uniqueItems": true},
        "test": {"type": "array", "items": {"$ref": "common-envelope.schema.json#/$defs/id"}, "minItems": 1, "uniqueItems": true},
        "group_keys": {"type": "object", "additionalProperties": {"$ref": "common-envelope.schema.json#/$defs/id"}}
      },
      "additionalProperties": false
    },
    "schema_manifest_id": {"$ref": "common-envelope.schema.json#/$defs/id"},
    "rights_summary": {"type": "object", "required": ["status", "exception_count"], "properties": {"status": {"enum": ["pass", "fail", "unknown"]}, "exception_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "dataset_eligibility_evidence_id": {"$ref": "common-envelope.schema.json#/$defs/id"},
    "approval_evidence_ids": {"type": "array", "items": {"$ref": "common-envelope.schema.json#/$defs/id"}, "minItems": 1, "uniqueItems": true},
    "approved": {"type": "boolean"},
    "frozen": {"type": "boolean"},
    "training_allowed": {"type": "boolean"},
    "dataset_manifest_id": {"$ref": "common-envelope.schema.json#/$defs/id"},
    "content_fingerprint": {"$ref": "common-envelope.schema.json#/$defs/checksum"},
    "supersedes": {"$ref": "common-envelope.schema.json#/$defs/id"}
  },
  "if": {"properties": {"status": {"const": "frozen"}}},
  "then": {"properties": {"approved": {"const": true}, "frozen": {"const": true}, "training_allowed": {"const": true}}},
  "unevaluatedProperties": false
}
