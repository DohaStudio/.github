{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dohastudio.org/common-ai/v1/training-eligibility.schema.json",
  "title": "TrainingEligibility v1",
  "allOf": [{"$ref": "common-envelope.schema.json"}],
  "type": "object",
  "required": ["training_eligibility_id", "candidate_id", "candidate_status", "rights_metadata_id", "policy_version", "usage_purpose", "checks", "approved", "training_allowed", "decision", "reason_codes", "reviewed_by", "reviewed_at", "expires_at"],
  "properties": {
    "schema_name": {"const": "training_eligibility"},
    "training_eligibility_id": {"$ref": "common-envelope.schema.json#/$defs/id"},
    "candidate_id": {"$ref": "common-envelope.schema.json#/$defs/id"},
    "candidate_status": {"enum": ["draft", "submitted", "in_review", "approved", "rejected", "included_in_dataset", "trained"]},
    "rights_metadata_id": {"$ref": "common-envelope.schema.json#/$defs/id"},
    "policy_version": {"$ref": "common-envelope.schema.json#/$defs/semver"},
    "usage_purpose": {"type": "string", "minLength": 1},
    "checks": {
      "type": "object",
      "required": ["review", "rights", "provenance", "consent", "retention", "purpose_scope", "quality", "pii", "lineage", "reference_source_separation"],
      "properties": {"review": {"$ref": "#/$defs/check"}, "rights": {"$ref": "#/$defs/check"}, "provenance": {"$ref": "#/$defs/check"}, "consent": {"$ref": "#/$defs/check"}, "retention": {"$ref": "#/$defs/check"}, "purpose_scope": {"$ref": "#/$defs/check"}, "quality": {"$ref": "#/$defs/check"}, "pii": {"$ref": "#/$defs/check"}, "lineage": {"$ref": "#/$defs/check"}, "reference_source_separation": {"$ref": "#/$defs/check"}},
      "additionalProperties": false
    },
    "approved": {"type": "boolean"},
    "training_allowed": {"type": "boolean"},
    "decision": {"enum": ["eligible", "ineligible", "needs_review", "revoked"]},
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reviewed_by": {"$ref": "common-envelope.schema.json#/$defs/id"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"check": {"enum": ["pass", "fail", "unknown", "missing", "expired", "revoked"]}},
  "if": {"properties": {"training_allowed": {"const": true}}},
  "then": {"properties": {"candidate_status": {"const": "approved"}, "approved": {"const": true}, "decision": {"const": "eligible"}}},
  "unevaluatedProperties": false
}
